<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaCT.Api</RootNamespace>
    <UserSecretsId>pact-v02-96a80f0d-8ad7-46f6-b662-e294ff2f5606</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;artifacts/**;web/**</DefaultItemExcludes>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build;ComputeFilesToPublish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/web" Command="npm ci --ignore-scripts --no-audit --no-fund" Condition="!Exists('$(MSBuildProjectDirectory)/web/node_modules/.package-lock.json')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/web" Command="npm run build" />
  </Target>

</Project>
